{
  "name": "sheishiwodi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm --filter @sheishiwodi/shared build && pnpm --parallel --filter @sheishiwodi/shared --filter @sheishiwodi/server --filter @sheishiwodi/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint --no-error-on-unmatched-pattern \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.ts\"",
    "test": "pnpm --filter @sheishiwodi/shared build && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @sheishiwodi/shared build && pnpm test:e2e:normal && pnpm test:e2e:spectator && pnpm test:e2e:tie",
    "test:e2e:normal": "node tests/e2e/run.mjs normal",
    "test:e2e:spectator": "node tests/e2e/run.mjs spectator",
    "test:e2e:tie": "node tests/e2e/run.mjs tie",
    "test:live": "node tests/live/run.mjs && pnpm --filter @sheishiwodi/shared build && node tests/live/launch.mjs",
    "test:live:smoke": "node tests/live/run.mjs",
    "test:live:policy": "pnpm --filter @sheishiwodi/shared build && node tests/live/launch.mjs policy",
    "test:live:review": "pnpm --filter @sheishiwodi/shared build && node tests/live/launch-review.mjs",
    "test:live:full": "pnpm --filter @sheishiwodi/shared build && node tests/live/launch.mjs full"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0"
  }
}
