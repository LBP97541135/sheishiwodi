# Agent 提供方开关：fake（默认，永不联网）| tokendance（真实中转站）
# 仅当值为 tokendance 且下方 Base URL 与 API Key 均非空时才启用真实模型。
AGENT_PROVIDER=fake

# Tokendance（OpenAI 兼容中转站）配置。这两项只在服务端读取，
# 绝不进入浏览器、数据库、日志、仓库或复盘。真实 Key 请写入被 gitignore 的 .env，不要提交。
TOKENDANCE_BASE_URL=https://tokendance.space/gateway/v1
TOKENDANCE_API_KEY=

# 可选：未在“模型档案”界面为某角色选择 model 时的回退 model ID（留空则该角色未配置时报错）。
TOKENDANCE_DEFAULT_MODEL=
