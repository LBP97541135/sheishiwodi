# Agent 提供方开关：fake（默认，永不联网）| tokendance | openai-compatible
# 仅当所选真实 provider 的 Base URL 与 API Key 均非空时才启用真实模型。
AGENT_PROVIDER=fake

# Tokendance（OpenAI 兼容中转站）配置。这两项只在服务端读取，
# 绝不进入浏览器、数据库、日志、仓库或复盘。真实 Key 请写入被 gitignore 的 .env，不要提交。
TOKENDANCE_BASE_URL=https://tokendance.space/gateway/v1
TOKENDANCE_API_KEY=

# 可选：未在“模型档案”界面为某角色选择 model 时的回退 model ID。
# 现在共享层已为三角色内置默认 model ID（deepseek-v4-flash-0731 / seed-2.1-turbo / qwen3.7-plus），
# 一般无需设置；此项仅作为最后兜底。
TOKENDANCE_DEFAULT_MODEL=

# 可选：赛后复盘 Agent 的独立 model ID。留空时回退到 TOKENDANCE_DEFAULT_MODEL，
# 两者都为空时使用 deepseek-v4-flash。只保存 model ID，不包含任何认证信息。
TOKENDANCE_REVIEW_MODEL=

# 可选：加速模型输出（默认留空=不改变行为）。这些只是运行时调参，绝不含 Key/URL。
# 单次模型请求超时（毫秒），默认 60000（推理模型即便关链首字也可能偏慢，留足余量避免误触发重试风暴）。
TOKENDANCE_TIMEOUT_MS=
# 系统级失败最大重试次数，默认 2。
TOKENDANCE_MAX_RETRIES=
# 每次重试前的等待毫秒，默认 800。
TOKENDANCE_RETRY_DELAY_MS=
# 关闭模型推理链：deepseek / 豆包(seed) / 千问(qwen) 已由服务端按模型家族自动下发正确参数
# （qwen→enable_thinking:false；seed/doubao 与 deepseek→thinking.type=disabled），无需在此配置。
# 本项仅为“其他模型”的通用兜底：JSON，合并进每次 /chat/completions 请求体（会被家族专用参数覆盖）。
# 若某模型对未知参数报 400，改用它接受的键；即便推理未关，服务端也会剥离 <think> 块兜底解析。
TOKENDANCE_EXTRA_BODY=
# 设为 1 打印脱敏计时日志（角色/model/动作/耗时/是否走了修复重试），绝不含 Key/URL/响应正文。
AGENT_DEBUG_TIMING=

# 通用 OpenAI Chat Completions 兼容中转站。
# 与 Tokendance 配置二选一；通用模式不继承项目内置或统一默认 model ID。
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# 必填：赛后复盘评价 model ID。通用模式不提供默认值，也不回退参赛模型。
OPENAI_COMPATIBLE_REVIEW_MODEL=

# 三个参赛角色的 model ID 请启动服务后在“模型档案”中手动填写并保存。
# 即使中转站没有 GET /models，输入框也可直接填写；三角色或评测 model 未配齐时禁止开局。

# 可选运行参数；语义与 TOKENDANCE_* 同名项一致。
OPENAI_COMPATIBLE_TIMEOUT_MS=
OPENAI_COMPATIBLE_MAX_RETRIES=
OPENAI_COMPATIBLE_RETRY_DELAY_MS=
OPENAI_COMPATIBLE_EXTRA_BODY=

# 仅供显式真实模型验收命令使用，不是应用运行时默认 model：
# - test:live:smoke 使用 SMOKE_MODEL；
# - test:live:policy/full 使用三个角色 model；
# - test:live:review 使用上方 REVIEW_MODEL。
OPENAI_COMPATIBLE_SMOKE_MODEL=
OPENAI_COMPATIBLE_DEEPSEEK_MODEL=
OPENAI_COMPATIBLE_DOUBAO_MODEL=
OPENAI_COMPATIBLE_QWEN_MODEL=
